# ──────────────────────────────────────────────────────────────────────────
# ID Side SDK — .gitignore
# PUBLIC repo. Absolute priority: no secret may ever reach history.
# When in doubt, ignore it.
# ──────────────────────────────────────────────────────────────────────────

# ── Secrets & cryptographic material (NEVER COMMIT) ────────────────────────
# ACT signing private keys (ECDSA P-256) live ONLY in the private cloud infra /
# a KMS, never here.
*.pem
*.key
*.keystore
*.jks
*.p8
*.p12
*.pfx
*.der
*.crt
*.cer
*.csr
*.gpg
*.asc
id_rsa*
id_ecdsa*
id_ed25519*
*_private*
*-private*
*.private
private_key*
privatekey*
secrets.*
secret.*
credentials*
.credentials/
*.secret
*.secrets

# ── Environment variables ──────────────────────────────────────────────────
.env
.env.*
!.env.example
*.env
.envrc

# ── Tokens / sensitive config files ────────────────────────────────────────
.netrc
.npmrc
.pypirc
*.token
*token*.json
service-account*.json
gcp-*.json
aws-credentials*
.aws/
.ssh/

# ── Confidential / NDA documents (hygiene — no doc binaries here) ──────────
*.pdf
*.docx
*.xlsx

# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
venv/
.venv/
env/
ENV/

# ── Node.js ────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnp.*
.yarn/
*.tsbuildinfo
coverage/
.next/
out/
.turbo/
# `npm pack` output (scripts/check_publishable.sh builds one on every run).
*.tgz

# ── detect-secrets ─────────────────────────────────────────────────────────
# The baseline is versioned; do not ignore .secrets.baseline.

# ── OS ─────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── IDE / Editors ──────────────────────────────────────────────────────────
.idea/
.vscode/
!.vscode/extensions.json
*.swp
*.swo
*~
.\#*
\#*\#

# ── Misc ───────────────────────────────────────────────────────────────────
*.log
tmp/
.cache/

# ── AI agent instructions (kept out of the public repo) ────────────────────
CLAUDE.md

# Browser debug artefacts from the Playwright MCP server — never source.
.playwright-mcp/

# The Node quickstart, extracted and rewritten to import the local sources by
# scripts/check_docs_examples.sh. Removed by that script's EXIT trap, which a
# signal does not run — so it must never be committable.
packages/node/.docs-example.scratch.mjs

  "placeholder": {
    "note": "A placeholder is [LABEL_n]. Text matching this pattern is never matched by any rule, and numbering for a label starts above the highest n already present in the request.",
    "regex": "\\[[A-Z0-9_]{1,24}_[0-9]{1,9}\\]"
  },
  "limits": {
    "max_text_chars": 8388608,
    "max_depth": 128,
    "max_passes": 8,
    "keyword_window": 64,
    "custom_entries": 500,
    "custom_value_chars": 200,
    "pattern_run": 64
  },
  "groups": [
    {
      "id": "contact",
      "title": "Contact details"

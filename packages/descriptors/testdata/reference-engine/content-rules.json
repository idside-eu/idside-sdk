        },
        {
          "regex": "(?:^|[^A-Za-z0-9_.-])(?:[A-Za-z0-9]{1,24}[_.-]){0,3}(?:password|passwd|passphrase|pwd|secret|api[_-]?key|apikey|access[_-]?key|auth[_-]?token|access[_-]?token|token|credentials?|mot[ ]de[ ]passe|mdp|pass)(?:[_.-][A-Za-z0-9]{1,24}){0,3}[\\\"']?[ \\t]{0,4}(?:=>|[:=])[ \\t]{0,4}'(?!(?:[Ss][Tt][Rr][Ii][Nn][Gg]|[Nn][Uu][Mm][Bb][Ee][Rr]|[Bb][Oo][Oo][Ll][Ee][Aa][Nn]|[Bb][Oo][Oo][Ll]|[Ss][Tt][Rr]|[Ii][Nn][Tt]|[Ii][Nn][Tt][Ee][Gg][Ee][Rr]|[Ff][Ll][Oo][Aa][Tt]|[Bb][Yy][Tt][Ee][Ss]|[Oo][Bb][Jj][Ee][Cc][Tt]|[Aa][Nn][Yy]|[Uu][Nn][Kk][Nn][Oo][Ww][Nn]|[Uu][Nn][Dd][Ee][Ff][Ii][Nn][Ee][Dd]|[Nn][Uu][Ll][Ll]|[Nn][Oo][Nn][Ee]|[Nn][Ii][Ll]|[Tt][Rr][Uu][Ee]|[Ff][Aa][Ll][Ss][Ee]|[Ii][Nn][Cc][Ll][Uu][Dd][Ee]|[Oo][Mm][Ii][Tt]|[Ss][Aa][Mm][Ee]\\-[Oo][Rr][Ii][Gg][Ii][Nn])(?![A-Za-z0-9_-])|(?:os\\.environ|os\\.getenv|getenv\\(|process\\.env|ENV\\[|env\\(|\\$\\{|\\$[A-Za-z_]|%[A-Za-z_][A-Za-z0-9_]{0,63}%))((?:[^'\\\\\\r\\n]|\\\\[^\\r\\n]){6,1024})'",
          "group": 1,

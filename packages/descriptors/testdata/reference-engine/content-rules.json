  "detectors": [
    {
      "id": "email",
      "group": "contact",
      "label": "EMAIL",
      "title": "E-mail address",
      "description": "An address name@domain.tld in Latin, Greek or Cyrillic letters (punycode domains included), except an at sign between spaces, an address spelled out, a git remote user@host:path and an image name such as logo@2x.png.",
      "default_enabled": true,
      "patterns": [
        {
          "regex": "(?:^|[^A-Za-z\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u024f\u0370-\u03ff\u0400-\u052f0-9._%+/:-]|[^/:]/|(?:^|[^A-Za-z\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u024f\u0370-\u03ff\u0400-\u052f0-9._%+/:-])[A-Za-z\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u024f\u0370-\u03ff\u0400-\u052f0-9._%+-]{1,64}:)([A-Za-z\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u024f\u0370-\u03ff\u0400-\u052f0-9_%+-][A-Za-z\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u024f\u0370-\u03ff\u0400-\u052f0-9._%+-]{0,63}@(?:[A-Za-z\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u024f\u0370-\u03ff\u0400-\u052f0-9-]{1,63}\\.){1,8}(?!(?:png|jpe?g|gif|webp|svg|avif|bmp|ico|tiff?|heic)(?![A-Za-z\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u024f\u0370-\u03ff\u0400-\u052f0-9-]))(?:xn--[A-Za-z0-9-]{1,59}|[A-Za-z\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u024f\u0370-\u03ff\u0400-\u052f]{2,24}))(?![A-Za-z\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u024f\u0370-\u03ff\u0400-\u052f0-9-]|:[A-Za-z0-9_~./-])",
          "group": 1,
          "prefilter": [
            "@"
          ]
        }
      ]
    },
    {
      "id": "phone",
      "group": "contact",
      "label": "PHONE",
      "title": "Phone number",
      "description": "A French number of ten digits starting 01 to 09, in pairs separated by one or two spaces, dots, dashes or slashes (the same throughout) or written +33, 0033 or (+33), and an international number written with a leading + and 9 to 15 digits, unless a currency (\u20ac, $, \u00a3, EUR, USD...) follows it directly.",
      "default_enabled": true,
      "validator": "phone",
      "patterns": [
        {
          "regex": "(?:^|[^A-Za-z0-9+])(0[1-9]([ ./-]{0,2})[0-9]{2}\\2[0-9]{2}\\2[0-9]{2}\\2[0-9]{2})(?![A-Za-z0-9])",
          "group": 1,
          "prefilter": [
            "#digit"
          ]
        },
        {
          "regex": "(?:^|[^A-Za-z0-9+])(\\(?(?:\\+|00)33\\)?[ .-]{0,2}(?:\\(0\\)[ .-]{0,2})?[1-9](?:[ .-]{0,2}[0-9]{2}){4})(?![A-Za-z0-9]|[ ]{0,2}(?:\u20ac|\\$|\u00a3|EUR|USD|GBP|CHF|[Ee]uros?|[Dd]ollars?))",
          "group": 1,
          "prefilter": [
            "33"
          ]
        },
        {
          "regex": "(?:^|[^A-Za-z0-9+])(\\+[1-9][0-9]{6,14})(?![A-Za-z0-9]|[ ]{0,2}(?:\u20ac|\\$|\u00a3|EUR|USD|GBP|CHF|[Ee]uros?|[Dd]ollars?))",
          "group": 1,
          "prefilter": [
            "+"
          ]
        },
        {
          "regex": "(?:^|[^A-Za-z0-9+])(\\+[1-9][0-9]{0,3}(?:[ .-]{1,2}\\(?[0-9]{1,5}\\)?){1,6})(?![A-Za-z0-9]|[ ]{0,2}(?:\u20ac|\\$|\u00a3|EUR|USD|GBP|CHF|[Ee]uros?|[Dd]ollars?))",
          "group": 1,
          "prefilter": [
            "+"
          ]
        }
      ]
    },
    {
      "id": "ip_address",
      "group": "contact",
      "label": "IP_ADDRESS",
      "title": "IP address",
      "description": "An IPv4 address (four numbers of 0 to 255, optional /prefix) or an IPv6 address, except four numbers right after a version word (version, ver., release, build, firmware, fw, rev, revision, v) or followed by a fifth, and a compressed IPv6 address with neither a group of three or more hexadecimal digits nor an IPv4 tail (::1).",
      "default_enabled": true,
      "validator": "ip",
      "patterns": [
        {
          "regex": "(?:^|[^A-Za-z0-9])(?:version|ver|release|build|firmware|fw|revision|rev|v)[.:]{0,2}[ ]{0,3}[0-9]{1,3}(?:\\.[0-9]{1,3}){3}|(?:^|[^A-Za-z0-9.])((?:[0-9]{1,3}\\.){3}[0-9]{1,3}(?:/[0-9]{1,2})?)(?![A-Za-z0-9]|\\.[0-9])",
          "group": 1,
          "ignore_case": true,
          "prefilter": [
            "."
          ]
        },
        {
          "regex": "(?:^|[^A-Za-z0-9:.])((?:[0-9A-Fa-f]{0,4}:){2,7}(?:(?:[0-9]{1,3}\\.){3}[0-9]{1,3}|[0-9A-Fa-f]{1,4})?)(?![A-Za-z0-9:]|\\.[0-9])",
          "group": 1,
          "prefilter": [
            ":"
          ]
        }
      ]
    },
    {
      "id": "mac_address",
      "group": "contact",
      "label": "MAC_ADDRESS",
      "title": "MAC address",
      "description": "Six pairs of hexadecimal digits separated by colons or by dashes (the same throughout), or three groups of four separated by dots (xxxx.xxxx.xxxx), but not without a separator.",
      "default_enabled": true,
      "patterns": [
        {
          "regex": "(?:^|[^A-Za-z0-9:-])([0-9A-Fa-f]{2}([:-])[0-9A-Fa-f]{2}(?:\\2[0-9A-Fa-f]{2}){4})(?![A-Za-z0-9:-])",
          "group": 1,
          "prefilter": [
            ":",
            "-"
          ]
        },
        {
          "regex": "(?:^|[^A-Za-z0-9.])([0-9A-Fa-f]{4}\\.[0-9A-Fa-f]{4}\\.[0-9A-Fa-f]{4})(?![A-Za-z0-9.])",
          "group": 1,
          "prefilter": [
            "."
          ]
        }
      ]
    },
    {
      "id": "credit_card",
      "group": "banking",
      "label": "CARD",
      "title": "Payment card number",
      "description": "13 to 19 digits of a known card network passing the Luhn check, written together or grouped 4-4-4-4, 4-4-4-4-3 or 4-6-5 with one or two spaces, dashes or dots (the same throughout).",
      "default_enabled": true,
      "validator": "card",
      "patterns": [
        {
          "regex": "(?:^|[^A-Za-z0-9])([0-9]{4}([ .-]{1,2})[0-9]{4}\\2[0-9]{4}\\2[0-9]{4})(?![A-Za-z0-9])",
          "group": 1,
          "prefilter": [
            "#digit"
          ]
        },
        {
          "regex": "(?:^|[^A-Za-z0-9])([0-9]{4}([ .-]{1,2})[0-9]{4}\\2[0-9]{4}\\2[0-9]{4}\\2[0-9]{3})(?![A-Za-z0-9])",
          "group": 1,
          "prefilter": [
            "#digit"
          ]
        },
        {
          "regex": "(?:^|[^A-Za-z0-9])([0-9]{4}([ .-]{1,2})[0-9]{6}\\2[0-9]{5})(?![A-Za-z0-9])",
          "group": 1,
          "prefilter": [
            "#digit"
          ]
        },
        {
          "regex": "(?:^|[^A-Za-z0-9])([0-9]{13,19})(?![A-Za-z0-9])",
          "group": 1,
          "prefilter": [
            "#digit"
          ]
        }
      ]
    },
    {
      "id": "iban",
      "group": "banking",
      "label": "IBAN",
      "title": "IBAN",
      "description": "An IBAN of its country's registered length passing the mod-97 check, written together or in groups separated by spaces or dashes (a space allowed between the country and its check digits), but not a French RIB written as bank, branch, account and key.",
      "default_enabled": true,
      "validator": "iban",
      "patterns": [
        {
          "regex": "(?:^|[^A-Za-z0-9])([A-Z]{2}[ ]?[0-9]{2}(?:[ -]{0,2}[A-Z0-9]{4}){2,7}(?:[ -]{0,2}[A-Z0-9]{1,4})?)(?![A-Za-z0-9])",
          "group": 1,
          "ignore_case": true,
          "prefilter": [
            "#digit"
          ]
        }
      ]
    },
    {
      "id": "bic",
      "group": "banking",
      "label": "BIC",
      "title": "BIC / SWIFT code",
      "description": "An 8- or 11-character code in capitals with a valid country code, only within 64 characters of the word BIC (or B.I.C.) or SWIFT.",
      "default_enabled": true,
      "validator": "bic",
      "patterns": [
        {
          "regex": "(?:^|[^A-Za-z0-9])([A-Z]{4}[A-Z]{2}[A-Z0-9]{2}(?:[A-Z0-9]{3})?)(?![A-Za-z0-9])",
          "group": 1,
          "keywords": [
            "bic",
            "b.i.c",
            "swift"
          ],
          "prefilter": []
        }
      ]
    },
    {
      "id": "fr_nir",
      "group": "french_ids",
      "label": "NIR",
      "title": "French social security number (NIR)",
      "description": "15 characters (Corsica 2A and 2B included) passing the key check, written together or grouped by spaces, dots or dashes.",
      "default_enabled": true,
      "validator": "nir",
      "patterns": [
        {
          "regex": "(?:^|[^A-Za-z0-9])([1-8]([ .-]?)[0-9]{2}\\2(?:0[1-9]|1[0-2]|[2-9][0-9])\\2(?:[0-9]{2}|2[ABab])\\2[0-9]{3}\\2[0-9]{3}[ .-]?[0-9]{2})(?![A-Za-z0-9])",
          "group": 1,
          "prefilter": [
            "#digit"
          ]
        }
      ]
    },
    {
      "id": "fr_siren",
      "group": "french_ids",
      "label": "SIREN",
      "title": "SIREN number",
      "description": "9 digits passing the Luhn check, grouped or not by spaces, dots or dashes, only within 64 characters of the word SIREN, SIRENE or RCS (or R.C.S.).",
      "default_enabled": true,
      "validator": "siren",
      "patterns": [
        {
          "regex": "(?:^|[^A-Za-z0-9])([0-9]{3}([ .-]?)[0-9]{3}\\2[0-9]{3})(?![A-Za-z0-9])",
          "group": 1,
          "keywords": [
            "siren",
            "sirene",
            "rcs",
            "r.c.s",
            "s.i.r.e.n"
          ],
          "prefilter": []
        }
      ]
    },
    {
      "id": "fr_siret",
      "group": "french_ids",
      "label": "SIRET",
      "title": "SIRET number",
      "description": "14 digits passing the Luhn check (or the La Poste rule), grouped 3-3-3-5, 3-3-3-3-2 or not at all, only within 64 characters of the word SIRET (or S.I.R.E.T.).",
      "default_enabled": true,
      "validator": "siret",
      "patterns": [
        {
          "regex": "(?:^|[^A-Za-z0-9])([0-9]{3}([ .-]?)[0-9]{3}\\2[0-9]{3}(?:[ .-]?[0-9]{5}|\\2[0-9]{3}\\2[0-9]{2}))(?![A-Za-z0-9])",
          "group": 1,
          "keywords": [
            "siret",
            "s.i.r.e.t"
          ],
          "prefilter": []
        }
      ]
    },
    {
      "id": "fr_vat",
      "group": "french_ids",
      "label": "VAT_NUMBER",
      "title": "French VAT number",
      "description": "FR followed by a two-character key and a SIREN, spaces allowed, passing the key check.",
      "default_enabled": true,
      "validator": "fr_vat",
      "patterns": [
        {
          "regex": "(?:^|[^A-Za-z0-9])(FR[ ]?[0-9A-HJ-NP-Z]{2}[ ]?[0-9]{3}[ ]?[0-9]{3}[ ]?[0-9]{3})(?![A-Za-z0-9])",
          "group": 1,
          "ignore_case": true,
          "prefilter": [
            "fr"
          ]
        }
      ]
    },
    {
      "id": "fr_plate",
      "group": "french_ids",
      "label": "PLATE",
      "title": "French licence plate",
      "description": "A plate of the current AA-123-AA format in capitals, with dashes, spaces, dots or nothing between the parts and an optional department (-69, -2A), but not the pre-2009 format, a lowercase plate or 000.",
      "default_enabled": true,
      "validator": "plate",
      "patterns": [
        {
          "regex": "(?:^|[^A-Za-z0-9-])([A-HJ-NP-TV-Z]{2}[ .-]?[0-9]{3}[ .-]?[A-HJ-NP-TV-Z]{2}(?:-(?:[0-9]{2,3}|2[AB]))?)(?![A-Za-z0-9-])",
          "group": 1,
          "prefilter": [
            "#digit"
          ]
        }
      ]
    },
    {
      "id": "key_openai",
      "group": "ai_keys",
      "label": "API_KEY",
      "title": "OpenAI API key",
      "description": "A key starting sk-, sk-proj-, sk-svcacct- or sk-admin- followed by at least 40 characters.",
      "default_enabled": true,
      "patterns": [
        {
          "regex": "(?:^|[^A-Za-z0-9_-])(sk-(?!ant-)(?:proj-|svcacct-|admin-)?[A-Za-z0-9_-]{40,512})(?![A-Za-z0-9_-])",
          "group": 1,
          "prefilter": [
            "sk-"
          ]
        }
      ]
    },
    {
      "id": "key_anthropic",
      "group": "ai_keys",
      "label": "API_KEY",
      "title": "Anthropic API key",
      "description": "A key starting sk-ant- followed by at least 32 characters.",
      "default_enabled": true,
      "patterns": [
        {
          "regex": "(?:^|[^A-Za-z0-9_-])(sk-ant-[A-Za-z0-9_-]{32,512})(?![A-Za-z0-9_-])",
          "group": 1,
          "prefilter": [
            "sk-ant-"
          ]
        }
      ]
    },
    {
      "id": "key_google",
      "group": "ai_keys",
      "label": "API_KEY",
      "title": "Google API key",
      "description": "A key starting AIza followed by 35 characters (Gemini and other Google APIs).",
      "default_enabled": true,
      "patterns": [
        {
          "regex": "(?:^|[^A-Za-z0-9_-])(AIza[0-9A-Za-z_-]{35})(?![A-Za-z0-9_-])",
          "group": 1,
          "prefilter": [
            "aiza"
          ]
        }
      ]
    },
    {
      "id": "key_mistral",
      "group": "ai_keys",
      "label": "API_KEY",
      "title": "Mistral API key",
      "description": "32 letters and digits within 64 characters of the word Mistral, MistralAI, MistralClient or Codestral, since the key has no prefix of its own.",
      "default_enabled": true,
      "patterns": [
        {
          "regex": "(?:^|[^A-Za-z0-9])([A-Za-z0-9]{32})(?![A-Za-z0-9])",
          "group": 1,
          "keywords": [
            "mistral",
            "mistralai",
            "mistralclient",
            "codestral"
          ],
          "prefilter": []
        }
      ]
    },
    {
      "id": "key_deepseek",
      "group": "ai_keys",
      "label": "API_KEY",
      "title": "DeepSeek API key",
      "description": "sk- followed by exactly 32 lowercase hexadecimal characters.",
      "default_enabled": true,
      "patterns": [
        {
          "regex": "(?:^|[^A-Za-z0-9_-])(sk-[0-9a-f]{32})(?![A-Za-z0-9_-])",
          "group": 1,
          "prefilter": [
            "sk-"
          ]
        }
      ]
    },
    {
      "id": "key_idside",
      "group": "ai_keys",
      "label": "API_KEY",
      "title": "ID Side secret key",
      "description": "sk_live_ or sk_test_ followed by exactly 32 letters and digits, the format of this SDK's keys.",
      "default_enabled": true,
      "patterns": [
        {
          "regex": "(?:^|[^A-Za-z0-9_])(sk_(?:live|test)_[A-Za-z0-9]{32})(?![A-Za-z0-9_])",
          "group": 1,
          "prefilter": [
            "sk_"
          ]
        }
      ]
    },
    {
      "id": "key_aws",
      "group": "tech_keys",
      "label": "API_KEY",
      "title": "AWS access key id",
      "description": "An access key id starting AKIA, ASIA or another AWS key id prefix followed by 16 capitals and digits, but not the 40-character secret access key, which has no prefix.",
      "default_enabled": true,
      "patterns": [
        {
          "regex": "(?:^|[^A-Za-z0-9])((?:AKIA|ASIA|ABIA|ACCA|AGPA|AIDA|AIPA|ANPA|ANVA|APKA|AROA)[0-9A-Z]{16})(?![A-Za-z0-9])",
          "group": 1,
          "prefilter": [
            "akia",
            "asia",
            "abia",
            "acca",
            "agpa",
            "aida",
            "aipa",
            "anpa",
            "anva",
            "apka",
            "aroa"
          ]
        }
      ]
    },
    {
      "id": "key_github",
      "group": "tech_keys",
      "label": "API_KEY",
      "title": "GitHub token",
      "description": "A token starting ghp_, gho_, ghu_, ghs_, ghr_ or github_pat_.",
      "default_enabled": true,
      "patterns": [
        {
          "regex": "(?:^|[^A-Za-z0-9_])((?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{36,255})(?![A-Za-z0-9_])",
          "group": 1,
          "prefilter": [
            "gh"
          ]
        },
        {
          "regex": "(?:^|[^A-Za-z0-9_])(github_pat_[A-Za-z0-9_]{22,255})(?![A-Za-z0-9_])",
          "group": 1,
          "prefilter": [
            "github_pat_"
          ]
        }
      ]
    },
    {
      "id": "key_gitlab",
      "group": "tech_keys",
      "label": "API_KEY",
      "title": "GitLab token",
      "description": "A token with a documented GitLab prefix (glpat-, gldt-, glrt-, glcbt-, glptt-, glft-, glffct-, glimt-, glagent-, glsoat-, gloas-, glwt-), any suffix attached to it by dots included.",
      "default_enabled": true,
      "patterns": [
        {
          "regex": "(?:^|[^A-Za-z0-9_-])(gl(?:pat|dt|rtr|rt|ptt|ffct|ft|soat|cbt|imt|agent|oas|wt)-[A-Za-z0-9_-]{20,255}(?:\\.[A-Za-z0-9_-]{1,64}){0,4})(?![A-Za-z0-9_-])",
          "group": 1,
          "prefilter": [
            "gl"
          ]
        }
      ]
    },
    {
      "id": "key_slack",
      "group": "tech_keys",
      "label": "API_KEY",
      "title": "Slack token or webhook",
      "description": "A token starting xoxb-, xoxp-, another xox prefix or xapp- (rotating app-level tokens included), and a hooks.slack.com webhook URL with or without its scheme.",
      "default_enabled": true,
      "patterns": [
        {
          "regex": "(?:^|[^A-Za-z0-9_-])((?:xoxe\\.)?(?:xapp|xox[abeoprs])-[A-Za-z0-9-]{10,255})(?![A-Za-z0-9_-])",
          "group": 1,
          "prefilter": [
            "xox",
            "xapp-"
          ]
        },
        {
          "regex": "(?:^|[^A-Za-z0-9.])((?:https?://)?hooks\\.slack\\.com/(?:services|workflows|triggers)/[A-Za-z0-9/_-]{20,255})",
          "group": 1,
          "prefilter": [
            "hooks.slack.com"
          ]
        }
      ]
    },
    {
      "id": "key_stripe",
      "group": "tech_keys",
      "label": "API_KEY",
      "title": "Stripe secret key",
      "description": "A secret starting sk_live_, sk_test_, rk_live_, rk_test_ or whsec_ (publishable pk_ keys are public by design), an sk_ key of exactly 32 characters after its prefix being counted as an ID Side key.",
      "default_enabled": true,
      "patterns": [
        {
          "regex": "(?:^|[^A-Za-z0-9_])((?:sk|rk)_(?:live|test)_[A-Za-z0-9]{20,247})(?![A-Za-z0-9_])",
          "group": 1,
          "prefilter": [
            "k_live_",
            "k_test_"
          ]
        },
        {
          "regex": "(?:^|[^A-Za-z0-9_])(whsec_[A-Za-z0-9]{24,128})(?![A-Za-z0-9_])",
          "group": 1,
          "prefilter": [
            "whsec_"
          ]
        }
      ]
    },
    {
      "id": "key_twilio",
      "group": "tech_keys",
      "label": "API_KEY",
      "title": "Twilio API key",
      "description": "SK followed by 32 hexadecimal characters.",
      "default_enabled": true,
      "patterns": [
        {
          "regex": "(?:^|[^A-Za-z0-9])(SK[0-9a-fA-F]{32})(?![A-Za-z0-9])",
          "group": 1,
          "prefilter": [
            "sk"
          ]
        }
      ]
    },
    {
      "id": "key_sendgrid",
      "group": "tech_keys",
      "label": "API_KEY",
      "title": "SendGrid API key",
      "description": "SG. followed by two parts of 22 and 43 characters.",
      "default_enabled": true,
      "patterns": [
        {
          "regex": "(?:^|[^A-Za-z0-9_-])(SG\\.[A-Za-z0-9_-]{22}\\.[A-Za-z0-9_-]{43})(?![A-Za-z0-9_-])",
          "group": 1,
          "prefilter": [
            "sg."
          ]
        }
      ]
    },
    {
      "id": "key_npm",
      "group": "tech_keys",
      "label": "API_KEY",
      "title": "npm token",
      "description": "npm_ followed by 36 letters and digits.",
      "default_enabled": true,
      "patterns": [
        {
          "regex": "(?:^|[^A-Za-z0-9_])(npm_[A-Za-z0-9]{36})(?![A-Za-z0-9_])",
          "group": 1,
          "prefilter": [
            "npm_"
          ]
        }
      ]
    },
    {
      "id": "key_pypi",
      "group": "tech_keys",
      "label": "API_KEY",
      "title": "PyPI token",
      "description": "A pypi- upload token for pypi.org or test.pypi.org.",
      "default_enabled": true,
      "patterns": [
        {
          "regex": "(?:^|[^A-Za-z0-9_-])(pypi-(?:AgEIcHlwaS5vcmc|AgENdGVzdC5weXBpLm9yZw)[A-Za-z0-9_-]{50,2048})(?![A-Za-z0-9_-])",
          "group": 1,
          "prefilter": [
            "pypi-"
          ]
        }
      ]
    },
    {
      "id": "key_azure",
      "group": "tech_keys",
      "label": "API_KEY",
      "title": "Azure key",
      "description": "The AccountKey= (88 characters) or SharedAccessKey= (44 characters) value of a connection string, spaces allowed around =, and 32 hexadecimal characters within 64 characters of the word Azure.",
      "default_enabled": true,
      "patterns": [
        {
          "regex": "(?:^|[^A-Za-z0-9])AccountKey[ ]{0,4}=[ ]{0,4}([A-Za-z0-9+/]{86}==)",
          "group": 1,
          "prefilter": [
            "accountkey"
          ]
        },
        {
          "regex": "(?:^|[^A-Za-z0-9])SharedAccessKey[ ]{0,4}=[ ]{0,4}([A-Za-z0-9+/]{43}=)",
          "group": 1,
          "prefilter": [
            "sharedaccesskey"
          ]
        },
        {
          "regex": "(?:^|[^A-Za-z0-9])([0-9a-f]{32})(?![A-Za-z0-9])",
          "group": 1,
          "keywords": [
            "azure"
          ],
          "prefilter": []
        }
      ]
    },
    {
      "id": "jwt",
      "group": "tech_keys",
      "label": "TOKEN",
      "title": "JSON Web Token",
      "description": "Three base64url parts separated by dots, the first starting eyJ, without the full stop or other punctuation that follows it.",
      "default_enabled": true,
      "patterns": [
        {
          "regex": "(?:^|[^A-Za-z0-9_.-])(eyJ[A-Za-z0-9_-]{4,8192}\\.[A-Za-z0-9_-]{4,8192}\\.[A-Za-z0-9_-]{0,8192})(?![A-Za-z0-9_-]|\\.[A-Za-z0-9_-])",
          "group": 1,
          "prefilter": [
            "eyj"
          ]
        }
      ]
    },
    {
      "id": "bearer_token",
      "group": "tech_keys",
      "label": "TOKEN",
      "title": "Authorization header value",
      "description": "The credential after Authorization: Bearer or Proxy-Authorization: Bearer (in a header, JSON or code), after Bearer elsewhere when it holds a digit or a punctuation mark, and after Authorization: Basic.",
      "default_enabled": true,
      "patterns": [
        {
          "regex": "(?:^|[^A-Za-z0-9-])(?:proxy-)?authorization[\\\"']?[ ]{0,4}:[ ]{0,4}[\\\"']?bearer[ ]{1,4}([A-Za-z0-9._~+/-]{16,4096}={0,2})(?![A-Za-z0-9._~+/=-])",
          "group": 1,
          "ignore_case": true,
          "prefilter": [
            "bearer"
          ]
        },
        {
          "regex": "(?:^|[^A-Za-z0-9])bearer[ ]{1,4}(?=[A-Za-z]{0,4096}[0-9._~+/-])([A-Za-z0-9._~+/-]{16,4096}={0,2})(?![A-Za-z0-9._~+/=-])",
          "group": 1,
          "ignore_case": true,
          "prefilter": [
            "bearer"
          ]
        },
        {
          "regex": "(?:^|[^A-Za-z0-9-])(?:proxy-)?authorization[\\\"']?[ ]{0,4}:[ ]{0,4}[\\\"']?basic[ ]{1,4}([A-Za-z0-9+/]{8,4096}={0,2})(?![A-Za-z0-9+/=])",
          "group": 1,
          "ignore_case": true,
          "prefilter": [
            "basic"
          ]
        }
      ]
    },
    {
      "id": "private_key",
      "group": "secrets",
      "label": "PRIVATE_KEY",
      "title": "Private key",
      "description": "A PEM, OpenSSH or PGP private key block from its BEGIN line to its END line however its lines are written (escaped newlines in JSON, quoted e-mail, indented YAML, code), and without its END line the base64 lines and parts that follow its BEGIN line.",
      "default_enabled": true,
      "patterns": [
        {
          "regex": "(-----BEGIN[ A-Z0-9]{0,40}PRIVATE KEY[ A-Z0-9]{0,16}-----(?:(?:[^-]|-(?!----(?:BEGIN|END))){0,65536}-----END[ A-Z0-9]{0,40}PRIVATE KEY[ A-Z0-9]{0,16}-----|(?:(?:\\r\\n|\\n|\\r)[ \\t]{0,16}(?:[>|+][ \\t]{0,4}){0,4}[A-Za-z][A-Za-z0-9-]{0,30}:[ ]{0,4}[A-Za-z0-9 ,.:/+=_-]{0,256}(?![^\\r\\n\\\\\\\"'])){0,8}(?:(?:\\r\\n|\\n|\\r)(?=(?:\\r\\n|\\n|\\r)))?(?:[A-Za-z0-9+/=]{1,65536}(?![^\\r\\n\\\\\\\"']))?(?:(?:\\r\\n|\\n|\\r)[ \\t]{0,16}(?:[>|+][ \\t]{0,4}){0,4}[A-Za-z0-9+/=]{1,65536}(?![^\\r\\n\\\\\\\"'])|(?:\\\\[nrt]|[ ]\\+|<[A-Za-z/][A-Za-z0-9 /]{0,8}>|[^A-Za-z0-9+/=\\\\-]){1,16}(?:[A-Za-z0-9+/]{16,65536}={0,2}|[A-Za-z0-9+/]{1,65536}={1,2}|[A-Za-z0-9+/]{1,15}(?![^<'\\\"\\\\]))(?![A-Za-z0-9+/=])){0,4096}))",
          "group": 1,
          "prefilter": [
            "-----begin"
          ]
        }
      ]
    },
    {
      "id": "connection_string_password",
      "group": "secrets",
      "label": "PASSWORD",
      "title": "Password in a connection string",
      "description": "The user and password before the @ of a database or messaging URL (postgres, mysql, mongodb, redis, amqp...) or of an Oracle thin URL, the quoted or unquoted value of Password= or Pwd= within 64 characters of a word such as Server, Host or Database, and the value of PGPASSWORD, POSTGRES_PASSWORD, MYSQL_PASSWORD and their kin or of spring.datasource.password, unless that value is read from the environment (os.environ, process.env, ${...}).",
      "default_enabled": true,
      "patterns": [
        {
          "regex": "(?:^|[^A-Za-z0-9+.-])(?:postgres|postgresql|mysql|mariadb|mongodb|mongodb\\+srv|redis|rediss|amqp|amqps|mssql|sqlserver|oracle|clickhouse|cockroachdb|couchdb|neo4j|neo4j\\+s|bolt|ldap|ldaps|smtp|smtps|ftp|ftps|sftp)(?:\\+[A-Za-z0-9]{1,20})?://([^:/@ \\t\\r\\n\\\"'<>]{0,256}:[^ \\t\\r\\n/\\\"'<>]{1,256})@",
          "group": 1,
          "ignore_case": true,
          "prefilter": [
            "://"
          ]
        },
        {
          "regex": "(?:^|[^A-Za-z0-9])jdbc:oracle:thin:([A-Za-z0-9_$#.-]{1,128}/[^@ \\t\\r\\n\\\"'<>]{1,256})@",
          "group": 1,
          "ignore_case": true,
          "prefilter": [
            "jdbc:oracle:thin:"
          ]
        },
        {
          "regex": "(?:^|[^A-Za-z0-9])(?:password|pwd)[ ]{0,4}=[ ]{0,4}(?!(?:os\\.environ|os\\.getenv|getenv\\(|process\\.env|ENV\\[|env\\(|\\$\\{|\\$[A-Za-z_]|%[A-Za-z_][A-Za-z0-9_]{0,63}%))([^; \\t\\r\\n\\\"'<>]{1,256})",
          "group": 1,
          "ignore_case": true,
          "keywords": [
            "server",
            "data source",
            "database",
            "initial catalog",
            "user id",
            "uid",
            "host",
            "dsn",
            "jdbc"
          ],
          "prefilter": [
            "password",
            "pwd"
          ]
        },
        {
          "regex": "(?:^|[^A-Za-z0-9])(?:password|pwd)[ ]{0,4}=[ ]{0,4}'([^'\\r\\n]{1,256})'",
          "group": 1,
          "ignore_case": true,
          "keywords": [
            "server",
            "data source",
            "database",
            "initial catalog",
            "user id",
            "uid",
            "host",
            "dsn",
            "jdbc"
          ],
          "prefilter": [
            "password",
            "pwd"
          ]
        },
        {
          "regex": "(?:^|[^A-Za-z0-9])(?:password|pwd)[ ]{0,4}=[ ]{0,4}\\\"([^\\\"\\r\\n]{1,256})\\\"",
          "group": 1,
          "ignore_case": true,
          "keywords": [
            "server",
            "data source",
            "database",
            "initial catalog",
            "user id",
            "uid",
            "host",
            "dsn",
            "jdbc"
          ],
          "prefilter": [
            "password",
            "pwd"
          ]
        },
        {
          "regex": "(?:^|[^A-Za-z0-9_.])(?:(?:PG|POSTGRES_|MYSQL_|MYSQL_ROOT_|MARIADB_|MARIADB_ROOT_|MONGO_INITDB_ROOT_)PASSWORD|spring\\.datasource\\.password)[ ]{0,4}[=:][ ]{0,4}(?!(?:os\\.environ|os\\.getenv|getenv\\(|process\\.env|ENV\\[|env\\(|\\$\\{|\\$[A-Za-z_]|%[A-Za-z_][A-Za-z0-9_]{0,63}%))([^; \\t\\r\\n\\\"'<>]{1,256})",
          "group": 1,
          "prefilter": [
            "password"
          ]
        },
        {
          "regex": "(?:^|[^A-Za-z0-9_.])(?:(?:PG|POSTGRES_|MYSQL_|MYSQL_ROOT_|MARIADB_|MARIADB_ROOT_|MONGO_INITDB_ROOT_)PASSWORD|spring\\.datasource\\.password)[ ]{0,4}[=:][ ]{0,4}'([^'\\r\\n]{1,256})'",
          "group": 1,
          "prefilter": [
            "password"
          ]
        },
        {
          "regex": "(?:^|[^A-Za-z0-9_.])(?:(?:PG|POSTGRES_|MYSQL_|MYSQL_ROOT_|MARIADB_|MARIADB_ROOT_|MONGO_INITDB_ROOT_)PASSWORD|spring\\.datasource\\.password)[ ]{0,4}[=:][ ]{0,4}\\\"([^\\\"\\r\\n]{1,256})\\\"",
          "group": 1,
          "prefilter": [
            "password"
          ]
        }
      ]
    },
    {
      "id": "url_credentials",
      "group": "secrets",
      "label": "CREDENTIALS",
      "title": "Credentials in a URL",
      "description": "The user and password (or a token) before the @ of any other URL with a scheme, such as an https:// address.",

{
  "description": "Whether key material follows a private key's BEGIN line (the `private_key_material` check a pattern names in `followed_by`). Each case is the text after the BEGIN line `begin` (written in two pieces: no tracked file holds the marker whole); `material` is what the check must answer at the end of that line. A `$concat` value is the concatenation of its parts, a part being a string or a {repeat, times} object. The answers are stated by hand, at the bounds the catalogue's description names; each was also the answer of the look-ahead the check replaced.",
  "begin": {
    "$concat": [
      "-----BEGIN ",
      "RSA PRIVATE KEY-----"
    ]
  },
  "cases": [
    {
      "name": "one run of 32 base64 characters",
      "after": {
        "$concat": [
          "\n",
          {
            "repeat": "A",
            "times": 32
          }
        ]
      },
      "material": true
    },
    {
      "name": "one run of 31 is not key material",
      "after": {
        "$concat": [
          "\n",
          {
            "repeat": "A",
            "times": 31
          }
        ]
      },
      "material": false
    },
    {
      "name": "two runs of 16, a line break between",
      "after": {
        "$concat": [
          "\n",
          {
            "repeat": "A",
            "times": 16
          },
          "\n",
          {
            "repeat": "B",
            "times": 16
          }
        ]
      },
      "material": true
    },
    {
      "name": "a first run of 15 is too short",
      "after": {
        "$concat": [
          "\n",
          {
            "repeat": "A",
            "times": 15
          },
          "\n",
          {
            "repeat": "B",
            "times": 17
          }
        ]
      },
      "material": false
    },
    {
      "name": "a first run of 31 and one character",
      "after": {
        "$concat": [
          "\n",
          {
            "repeat": "A",
            "times": 31
          },
          " ",
          "B"
        ]
      },
      "material": true
    },
    {
      "name": "1,024 separators between the runs",
      "after": {
        "$concat": [
          "\n",
          {
            "repeat": "A",
            "times": 16
          },
          {
            "repeat": "\n",
            "times": 1024
          },
          {
            "repeat": "B",
            "times": 16
          }
        ]
      },
      "material": true
    },
    {
      "name": "1,025 separators between the runs",
      "after": {
        "$concat": [
          "\n",
          {
            "repeat": "A",
            "times": 16
          },
          {
            "repeat": "\n",
            "times": 1025
          },
          {
            "repeat": "B",
            "times": 16
          }
        ]
      },
      "material": false
    },
    {
      "name": "1,024 separators before the key",
      "after": {
        "$concat": [
          {
            "repeat": "\n",
            "times": 1024
          },
          {
            "repeat": "A",
            "times": 32
          }
        ]
      },
      "material": true
    },
    {
      "name": "1,025 separators before the key",
      "after": {
        "$concat": [
          {
            "repeat": "\n",
            "times": 1025
          },
          {
            "repeat": "A",
            "times": 32
          }
        ]
      },
      "material": false
    },
    {
      "name": "1,024 escaped line breaks before the key",
      "after": {
        "$concat": [
          {
            "repeat": "\\n",
            "times": 1024
          },
          {
            "repeat": "A",
            "times": 32
          }
        ]
      },
      "material": true
    },
    {
      "name": "1,025 escaped line breaks before the key",
      "after": {
        "$concat": [
          {
            "repeat": "\\n",
            "times": 1025
          },
          {
            "repeat": "A",
            "times": 32
          }
        ]
      },
      "material": false
    },
    {
      "name": "the letter of an escape may start the key",
      "after": {
        "$concat": [
          "\\n",
          {
            "repeat": "A",
            "times": 31
          }
        ]
      },
      "material": true
    },
    {
      "name": "the letter of an escape may start the second run",
      "after": {
        "$concat": [
          "\n",
          {
            "repeat": "A",
            "times": 16
          },
          "\\n",
          {
            "repeat": "B",
            "times": 15
          }
        ]
      },
      "material": true
    },
    {
      "name": "four header lines",
      "after": {
        "$concat": [
          {
            "repeat": "\nComment: x",
            "times": 4
          },
          "\n",
          {
            "repeat": "A",
            "times": 32
          }
        ]
      },
      "material": true
    },
    {
      "name": "five header lines",
      "after": {
        "$concat": [

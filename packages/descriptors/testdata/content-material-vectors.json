          {
            "repeat": "A",
            "times": 32
          }
        ]
      },
      "material": true
    },
    {
      "name": "513 separators after a header line",
      "after": {
        "$concat": [
          "\nComment: x",
          {
            "repeat": "\n",
            "times": 513
          },
          {
            "repeat": "A",
            "times": 32
          }
        ]
      },
      "material": false
    },
    {
      "name": "a value may end inside a <br>, which leaves fewer separators",
      "after": {
        "$concat": [
          "\nComment: ",
          {
            "repeat": "<br>",
            "times": 520

          "\n",
          {
            "repeat": "A",
            "times": 40
          }
        ]
      },
      "material": true
    },
    {
      "name": "no end of the value leaves 512 separators or fewer",
      "after": {
        "$concat": [
          "\nComment: ",
          {
            "repeat": "<br>",
            "times": 600
          },
          "\n",
          {
            "repeat": "A",
            "times": 40
          }
        ]
      },
      "material": false
    },
    {
      "name": "<br > after a value counts once",
      "after": {
        "$concat": [
          "\nComment: x<br >",
          {
            "repeat": "\n",
            "times": 511
          },
          {
            "repeat": "A",
            "times": 32
          }
        ]
      },
      "material": true
    },
    {
      "name": "<br > after a value, then one separator too many",
      "after": {
        "$concat": [
          "\nComment: x<br >",
          {
            "repeat": "\n",
            "times": 512
          },
          {
            "repeat": "A",
            "times": 32
          }
        ]
      },
      "material": false
    },
    {
      "name": "<br > after a blank is no shortcut",
      "after": {
        "$concat": [
          "\nComment: x <br >",
          {
            "repeat": "\n",
            "times": 511
          },
          {
            "repeat": "A",
            "times": 32
          }
        ]
      },
      "material": false
    },
    {

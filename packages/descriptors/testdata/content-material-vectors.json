          {
            "repeat": "A",
            "times": 32
          }
        ]
      },
      "material": true
    },
    {
      "name": "a header value of 257 characters",
      "after": {
        "$concat": [
          "\nComment:",
          {
            "repeat": ".",
            "times": 256
          },
          "x\n",
          {
            "repeat": "A",
            "times": 32
          }
        ]
      },
      "material": false
    },
    {
      "name": "512 separators after a header line",
      "after": {
        "$concat": [
          "\nComment: x",
          {
            "repeat": "\n",
            "times": 512

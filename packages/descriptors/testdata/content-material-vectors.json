            "repeat": "A",
            "times": 32
          }
        ]
      },
      "material": true
    },
    {
      "name": "a header name in lowercase is prose",
      "after": {
        "$concat": [
          "\ncomment: x\n",
          {
            "repeat": "A",
            "times": 32
          }
        ]
      },
      "material": false
    },
    {
      "name": "a header value of 256 characters",
      "after": {
        "$concat": [
          "\nComment:",

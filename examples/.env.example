# What the SDK reads from the environment — copy to `.env` and fill in.
#
# Nothing in examples/ loads this file. The examples run offline against
# stand-ins (see README.md), so they need no key at all; this documents what
# going live needs, and it is the whole list.

# ── ID Side ────────────────────────────────────────────────────────────────
# From the ID Side dashboard: sign up at https://sdk.idside.eu/dashboard/signup.
# Or, with no account, "Test without an account" on https://sdk.idside.eu/sdk:
# an sk_test_ key valid 24 hours, limited to 20 calls. A test key's proofs say
# mode "test", so they never count as production evidence.
# Without a key the SDK sends no Authorization header and the cloud refuses.
IDSIDE_API_KEY=sk_test_your_idside_key   # pragma: allowlist secret
# Optional: this is the default. Change it only for a local or staging cloud.
IDSIDE_BASE_URL=https://sdk.idside.eu

# ── your AI provider ──────────────────────────────────────────────────────
# Whatever the provider client you wrap reads. ID Side never sees this value:
# it is your key, used by the provider's own client, on a call ID Side proved.
OPENAI_API_KEY=sk-your_openai_key   # pragma: allowlist secret

# ── seeing why a call did not go out ──────────────────────────────────────
# Both SDKs journal to stderr, and write nothing unless asked. Nothing secret
# is ever written: no key, no user_id, no ubt, no prompt, no ACT token.
#   Node:   NODE_DEBUG=idside
#   Python: the `idside` logger at DEBUG — see docs/quickstart-python.md
NODE_DEBUG=
